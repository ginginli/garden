{
  "manifest_version": 3,
  "name": "Garden Horizons Helper",
  "version": "1.0.0",
  "description": "Quick access to Garden Horizons calculator, codes, and live stock tracker",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Garden Horizons Helper"
  },
  "permissions": [
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "https://gardenhorizons.org/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.roblox.com/games/*"],
      "js": ["content.js"],
      "css": ["content.css"]
    }
  ]
}
